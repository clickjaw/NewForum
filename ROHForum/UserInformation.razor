@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using ViewModels
@inject AuthenticationStateProvider authStateProvider
@inject ProtectedSessionStorage sessionStorage

@if (isLoaded)
{
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
}
else
{
    <p>Loading...</p>
}

@code {
    private bool isLoaded;
    UserSessionViewModel userModel;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }


    public string userNameParent { get; set; }
    public int userIdParent{ get; set; }
    public int userUpvotes{ get; set; }
    public int userDownvotes{ get; set; }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            isLoaded = true;
            await LoadStateAsync();
            StateHasChanged();
        }
    }

    private async Task LoadStateAsync()
    {
        var userSessionStorageResult = await sessionStorage.GetAsync<UserSessionViewModel>("UserSession");

        userModel = userSessionStorageResult.Success ? userSessionStorageResult.Value : new UserSessionViewModel()
            {
                Username = "",
                UserId = 0,
                TotalUpvotes =0,
                TotalDownvotes =0

            };

        UserModel user = _userService.GetUserByUsername(userModel.Username);
        
        List<PostsModel> userPosts = _postService.GetPostsByUser(user.UserId);

       
        // @foreach (var post in userPosts)
        // {
        //     user.TotalUpvotes += post.Upvote;
        //     user.TotalDownvotes += post.Downvote;
        // }

        isLoaded = true;
        userNameParent = userModel.Username;
        userIdParent = user.UserId;
        userUpvotes = user.TotalUpvotes;
        userDownvotes = user.TotalDownvotes;




    }


}
