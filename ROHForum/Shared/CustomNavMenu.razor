@using ROHForum.Data


<ul class="nav me-2">
    <li class="nav-item">
        
        @if (UserInformation.userUpvotes > UserInformation.userDownvotes )
        {
            <img class="upvoteArrow me-2" style="height:21px; width:16px;" src="/ROHFORUMART/greenArrowUp.png" /> @navbarKarmaTotal

        }else if(UserInformation.userUpvotes == UserInformation.userDownvotes){
            <p>0</p>
        }
        else
        {
            <img class="downvoteArrow" style="height:21px; width:16px;" src="/ROHFORUMART/redArrowDown.png" /> @navbarKarmaTotal

        }
    </li>
</ul>
<ul class="nav">
    <li class="nav-item">
        <div class="dropdown">
            <button class="customButton mx-2 px-4">All Communities</button>
            <div class="dropdown-content ps-4 pe-4" style="background:rgba(255,255,255, 1);  border-radius:5px;box-shadow: 5px 5px black;">


                @foreach(var tag in allTags){
                    <button class="customButton my-2 px-4" @onclick='()=> _navManager.NavigateTo("/posts/tag/" + tag.TagName)'>@tag.TagName</button>

                }

            </div>
        </div>
    </li>

</ul>

<ul class="nav col">
    <li class="nav-item">
        <div class="dropdown">
            <button class="customButton mx-2 px-4">Your Communities</button>
            <div class="dropdown-content ps-4 pe-4" style="background: rgba(255,255,255, 1);
    border-radius: 5px;
    box-shadow: 5px 5px black;">


                @foreach (var tag in userTags)
                {
                    <button class="customButton my-2 px-4" @onclick='()=> _navManager.NavigateTo("/posts/tag/" + tag.Tags)'>@tag.Tags</button>

                }

            </div>
        </div>
    </li>

</ul>
<ul class=" col-3">
    <li class="nav-item pt-3"><ROHForum.Pages.UserProfile.UserKarmaBar /></li>

</ul>

<ul class="nav">
    <li class="nav-item">
        <button class="px-4 mx-2 customKarmaBar" aria-current="page" @onclick='()=> _navManager.NavigateTo("/home/"+ UserInformation.userNameParent)'>Home</button>
    </li>
    <li class="nav-item">
        <button class="px-4 mx-2 customKarmaBar" @onclick='()=> _navManager.NavigateTo("/user/home/")'>




            @UserInformation.userNameParent 's Profile


        </button>
    </li>
    @*  <li class="nav-item">
        <button class="px-4 mx-2 customButton" @onclick="GoToTopPosts">Top Posts</button>
    </li>
    <li class="nav-item">
        <button class="px-4 mx-2 customButton" @onclick='()=> _navManager.NavigateTo("/posts/new")'>New Posts</button>
    </li> *@
    <li class="nav-item">
        <div class="dropdown">
            <button class="customButton mx-2 px-4">Posts</button>
            <div class="dropdown-content">
                <button class="customButton my-2 px-4 " @onclick='()=> _navManager.NavigateTo("/posts/top")'>Top Posts</button>
                <button class="customButton my-2 px-4" @onclick='()=> _navManager.NavigateTo("/posts/new")'>New Posts</button>
                <button class="customButton my-2 px-4" @onclick='()=> _navManager.NavigateTo("/users/top")'>Best Users</button>
            </div>
        </div>
    </li>

</ul>
<AddNewPost/>




@code {

    [CascadingParameter]
    public UserInformation UserInformation{ get; set; }

    public UserModel userModel = new();

    public List<TagModel> allTags = new();
    public List<PostsModel> userTags = new();

    public int navbarKarmaTotal =0;

    public void GoToTopPosts()
    {
        _navManager.NavigateTo("/posts/top");
    }

    protected override void OnInitialized()
    {
        
        allTags = _tagService.GetAllTagPosts();
        userTags = _tagService.GetTagsByUser(UserInformation.userIdParent);
        userModel = _userService.GetUserByUsername(UserInformation.userNameParent);
        navbarKarmaTotal = UserInformation.userUpvotes - UserInformation.userDownvotes;
    }



}

<style>
    .dropbtn {
        background-color: #04AA6D;
        color: white;
        padding: 16px;
        font-size: 16px;
        border: none;
    }

    .dropdown {
        position: relative;
        display: inline-block;
    }

    .dropdown-content {
        display: none;
        position: absolute;
        background-color: transparent;
        min-width: 160px;
        z-index: 1;
    }

        .dropdown-content a {
            color: black;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
        }

            .dropdown-content a:hover {
                background-color: #ddd;
            }

    .dropdown:hover .dropdown-content {
        display: block;
    }

    .dropdown:hover .dropbtn {
        background-color: #3e8e41;
    }
</style>