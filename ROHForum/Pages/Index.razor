@page "/home/{paramId}"
@using ROHForum.Data
@inject NavigationManager _navManager


<PageTitle>ROH Forum</PageTitle>

<div>
    <div class="d-flex justify-content-end">
        <EditForm Model="searchModel" Context="formContext">
            @* <InputText type="text" class="customButton" @bind-Value="searchModel.Search" @bind:event="oninput" /> *@
            @* <input type="text" class="customButton" @bind="searchModel.Search" @bind:event="oninput" /> *@

            <input type="text" class="customButton"  @oninput="UpdateInputValue" />
            <button type="button" class="customButton">Search Posts</button>
        </EditForm>
    </div>
    <div style="display:@searchDisplay">
        <p>
            <h1>Search results for: @searchModel.Search</h1>
        </p>
        @if (postSearchToggle == "none" && userSearchToggle == "none" && tagSearchToggle == "none") {
            <p>
                <h2>No results found</h2>
            </p>
        }
        <div class="mb-4">
            <ul class="nav col">
                <li class="nav-item" style="display:@postSearchToggleButton">
                    <div class="dropdown">
                        <button class="customButton mx-2 px-4" @onclick="PostToggle">Post Search</button>

                    </div>
                </li>
                <li class="nav-item" style="display:@userSearchToggleButton">
                    <div class="dropdown">
                        <button class="customButton mx-2 px-4" @onclick="UserToggle">User Results</button>

                    </div>
                </li>
                <li class="nav-item" style="display:@tagSearchToggleButton">
                    <div class="dropdown">
                        <button class="customButton mx-2 px-4" @onclick="TagToggle">Tag Results</button>

                    </div>
                </li>
            </ul>
        </div>
        <div style="display:@postSearchToggle">
            <h2>Post Results</h2>
            @foreach(var post in postSearchResults)
            {
                <div class="row p-2 m-2 postBorder">
                    <div class="col-md-2">
                        <div class="row"><img class="upvoteArrow" style="height:100%; width:40px;"  src="/ROHFORUMART/blankArrowUp.png" /> @post.Upvote</div>

                        <div class="row"><img class="downvoteArrow" style="height:100%; width:40px;" src="/ROHFORUMART/blankArrowDown.png"  /> @post.Downvote</div>
                    </div>
                    <div class="col-md-9 ">
                        <div class="row cursorPointer onHoverText" @onclick='(()=>_navManager.NavigateTo($"/posts/{post.PostId}"))'><p>@post.Title</p></div>
                        <div class="row cursorPointer onHoverText d-flex justify-content-between" @onclick='(()=>_navManager.NavigateTo($"/posts/tag/{post.Tags}"))'>
                            @if (post.PostComments is not null)
                            {
                                <div class="col">@post.PostComments.Count() comment(s)</div>
                                <div class="col">@post.PostCreated</div>
                                <div class="col-2">@post.Tags</div>

                            }
                            else
                            {
                                <div class="col">0 comments</div>
                                <div class="col">@post.PostCreated</div>
                                <div class="col-2">@post.Tags</div>

                            }
                        </div>
                    </div>

                    <div>
                    </div>
                </div>
            }
        </div>
        <div style="display:@userSearchToggle">
            <h2>User Search Results</h2>
            @foreach(var user in userSearchResults)
            {
                <div class="row p-2 m-2 postBorder w-50">
                    <div class="col-md-2">
                        <div class="row"><img class="upvoteArrow" style="height:100%; width:40px;" src="/ROHFORUMART/blankArrowUp.png" /> @user.TotalUpvotes</div>

                        <div class="row"><img class="downvoteArrow" style="height:100%; width:40px;" src="/ROHFORUMART/blankArrowDown.png" /> @user.TotalDownvotes</div>
                    </div>
                    <div class="col-md-9 ">
                        <div class="row cursorPointer onHoverText"><p>@user.Username</p></div>
                        <div class="row cursorPointer onHoverText d-flex justify-content-between" >
                            <div class="">
                                <ROHForum.Pages.UserProfile.UserKarmaBarSearchResults SearchUser="@user.Username" />
                            </div>

                        </div>
                    </div>

                    <div>
                    </div>
                </div>
            }
        </div>
        <div style="display:@tagSearchToggle">
            <h2>Tag Search Results</h2>
            <div>
                @foreach(var tag in tagSearchResults)
                {
                    <button class="customButton mx-2 px-4" @onclick='(()=>_navManager.NavigateTo($"/posts/tag/{tag.TagId}"))'>@tag.TagName</button>

                }
            </div>
        </div>
    </div>
    <div style="display:@defaultDisplay">
        <div>
            <h1>Homepage</h1>
        </div>
        <h1>paramId: @paramId</h1>
        <h1>cascadingParam: @UserInformation.userNameParent</h1>
    </div>

</div>

@code{
    [CascadingParameter]
    UserInformation UserInformation{ get; set; }

    [Parameter]
    public string paramId { get; set; }

    public SearchModel searchModel = new();

    public string postSearchToggle;
    public string userSearchToggle;
    public string tagSearchToggle;
    public string postSearchToggleButton;
    public string userSearchToggleButton;
    public string tagSearchToggleButton;

    public void PostToggle()
    {
        postSearchToggle = "block";
        userSearchToggle="none";
        tagSearchToggle = "none";
    }
    public void UserToggle()
    {

        postSearchToggle = "none";
        userSearchToggle = "block";
        tagSearchToggle = "none";
    }
    public void TagToggle()
    {

        postSearchToggle = "none";
        userSearchToggle="none";
        tagSearchToggle = "block";}

    public string doubleFont = "12px";
    public int doubleNum;
    public int totalNum;
    public string doubleLetter;
    public List<string> Letters = new();
    public List<PostsModel> postSearchResults = new();
    public List<UserModel> userSearchResults = new();
    public List<TagModel> tagSearchResults = new();
    public List<string> searchWord = new();

    public string defaultDisplay;
    public string searchDisplay;
    private string InputValue { get; set; } = string.Empty;



    private void UpdateInputValue(ChangeEventArgs e)
    {
        if (e.Value == String.Empty)
        {
            defaultDisplay = "block";
            searchDisplay = "none";
        }
        else
        {
            searchModel.Search = e.Value?.ToString() ?? string.Empty;
            if (searchWord.Count() > 0)
            {
                searchWord.Remove(searchWord[0]);
            }
            searchWord.Add(searchModel.Search);
            postSearchResults = _postService.GetPostsByStartingLetters(searchWord[0]);
            userSearchResults = _userService.GetUsersByStartingLetters(searchWord[0]);
            tagSearchResults = _tagService.GetTagsByStartingLetters(searchWord[0]);

            defaultDisplay = "none";
            searchDisplay = "block";
            @if (postSearchResults.Count() > 0)
            {
                postSearchToggle = "block";
                postSearchToggleButton = "block";
            }
            else
            {
                postSearchToggle = "none";
                postSearchToggleButton = "none";
            }
            @if (userSearchResults.Count() > 0)
            {
                userSearchToggle = "block";

                userSearchToggleButton = "block";
            }
            else
            {
                userSearchToggle = "none";
                userSearchToggleButton = "none";
            }
            @if (tagSearchResults.Count() > 0)
            {
                tagSearchToggle = "block";
                tagSearchToggleButton = "block";
            }
            else
            {
                tagSearchToggle = "none";
                tagSearchToggleButton = "none";
            }

            
            
        }
    }



    protected override void OnInitialized()
    {
        var test = UserInformation.userNameParent;
        doubleNum = 12;
        defaultDisplay = "block";
        searchDisplay = "none";
        postSearchToggle = "block";
        userSearchToggle = "block";
        tagSearchToggle = "block";
    }

    public void DoubleFontSize(int num)
    {
        totalNum += num * 2;
        doubleFont = $"{totalNum}px";

    }

    public void AddLetter()
    {
        Letters.Add("H");
    }

}

