@page "/newpost/add"
@using ROHForum.Data
@using ROHForum.Data.Models
@using ROHForum.Data.Service
@inject IPostService postService
@inject IUserService userService
@inject NavigationManager _navManager

<h3>Add New Post</h3>


<div class="container">
    <EditForm Model="@newPost" OnValidSubmit="Save" Context="formContext">
        <div>
            <div>
                <label>Title</label>
                <InputText @bind-Value="newPost.Title"/>            
            </div>
            <div>
                <label>Body</label>
                <InputText @bind-Value="newPost.Body" />
            </div>
            <div>
                <label>Tags</label>
                <InputText @bind-Value="newPost.Tags"/>            
            </div>


        </div>
        <div>
            <button type="submit">Add New Post</button>
        </div>


    </EditForm>

</div>



@code {
    [CascadingParameter]
    public UserInformation UserInformation{ get; set; }

    PostsModel newPost = new();


    TagModel tagModel = new();
    UserModel userModel = new();

    public void Save()
    {

        userModel = userService.GetUser(newPost.UserId);
        newPost.UserModel = userModel;
        newPost.UserId = UserInformation.userIdParent;
        postService.AddPost(newPost);
        tagModel.TagName = newPost.Tags;
        _tagService.AddNewTag(tagModel);
        _navManager.NavigateTo("/", true);

    }
}
