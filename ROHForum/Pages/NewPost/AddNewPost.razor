@page "/newpost/add"
@using ROHForum.Data
@using ROHForum.Data.Models
@using ROHForum.Data.Service
@inject IPostService postService
@inject IUserService userService
@inject NavigationManager _navManager

<h3>Add New Post</h3>


<div class="container d-flex">
    <EditForm Model="@newPost" OnValidSubmit="Save" Context="formContext">
        <div style="width:500px;">
            <div class="col m-3 p-4 ">

                <label class="row">Title</label>
                <InputText class="row customButton" style="width:100%; font-size:26px;" @bind-Value="newPost.Title" />
            </div>
            <div class="col m-3 p-4">
                <label class="row">Body</label>
                <InputTextArea class="row customButton" style="width:100%; font-size:26px; border:2px black solid;" @bind-Value="newPost.Body" />
            </div>
            <div class="col m-3 p-4">
                <label class="row">Tags</label>
                <InputText class="row customButton" style="width:100%; font-size:26px;" @bind-Value="newPost.Tags" />
            </div>


        </div>
        <div class="d-flex justify-content-end">
            <button type="submit" class="customButton">Add New Post</button>
        </div>


    </EditForm>

</div>



@code {
    [CascadingParameter]
    public UserInformation UserInformation{ get; set; }

    PostsModel newPost = new();


    TagModel tagModel = new();
    UserModel userModel = new();

    public void Save()
    {

        userModel = userService.GetUser(newPost.UserId);
        newPost.UserModel = userModel;
        newPost.UserId = UserInformation.userIdParent;
        postService.AddPost(newPost);
        tagModel.TagName = newPost.Tags;
        _tagService.AddNewTag(tagModel);
        _navManager.NavigateTo("/", true);

    }
}
