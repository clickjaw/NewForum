

<h1>@UserInformation.userNameParent activity</h1>

<div class="container m-2 p-4" style="border:solid black 5px;">
    <ul class="nav col">
        <li class="nav-item">
            <div class="dropdown">
                <button class="customButton mx-2 px-4" @onclick="PostToggle">Your Posts</button>

            </div>
        </li>
        <li class="nav-item">
            <div class="dropdown">
                <button class="customButton mx-2 px-4" @onclick="CommentToggle">Your Comments</button>

            </div>
        </li>
        <li class="nav-item">
            <div class="dropdown">
                <button class="customButton mx-2 px-4" @onclick="UpvoteToggle">Your Upvotes</button>

            </div>
        </li>
    </ul>

    <div>
        <div class="m-2 p-4" style="display: @postDisplay;">
            <div>
                <UserPosts/>
            </div>

        </div>
        <div class="m-2 p-4" style="display: @commentDisplay;">
            <div>
                <UserComments />
            </div>

        </div>
        <div class="m-2 p-4" style="display: @upvoteDisplay;">
            updoots
        </div>
    </div>
</div>

@code{
    [CascadingParameter]
    public UserInformation UserInformation{ get; set; }

    public string postDisplay;
    public string upvoteDisplay;
    public string commentDisplay;

    protected override void OnInitialized()
    {
        postDisplay = "block";
        upvoteDisplay = "none";
        commentDisplay = "none";

    }

    public void UpvoteToggle()
    {
        postDisplay = "none";
        upvoteDisplay = "block";
        commentDisplay = "none";

    }

    public void PostToggle()
    {
        postDisplay = "block";
        upvoteDisplay = "none";
        commentDisplay = "none";

    }
    public void CommentToggle()
    {
        commentDisplay = "block";
        postDisplay = "none";
        upvoteDisplay = "none";
        

    }

}