@page "/users/top/"

<div class="">



    <div class="container p-3" >
        <h1>Top Content</h1>
        @if (TotalPages > 1)
        {
            <nav aria-label="" class="d-flex justify-content-center">
                <ul class="pagination">
                    <li class="page-item  @(ShowPrevious ? "" : "disabled")">
                        <a class="page-link" asp-page="/users/top/" @onclick="(()=>DoPrevious())" asp-route-currentPage="@(CurrentPage - 1)">Previous</a>
                    </li>
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        <li class="page-item mx-2 @(i == CurrentPage ? "active" : "")">
                            <a disabled class="page-link" href="/users/top/" @onclick="(()=>DoSomethingElse(i))" asp-route-currentPage="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(ShowNext ? "" : "disabled")">
                        <a class="page-link" href="/users/top/" @onclick="(()=>DoNext())" asp-route-currentPage="@(CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>

        }
        @foreach (var user in users)
        {

            <div class="row p-2 m-2 postBorder w-50">
                <div class="col-md-2">
                    <div class="row"><img class="upvoteArrow" style="height:100%; width:40px;" src="/ROHFORUMART/blankArrowUp.png" /> @user.TotalUpvotes</div>

                    <div class="row"><img class="downvoteArrow" style="height:100%; width:40px;" src="/ROHFORUMART/blankArrowDown.png" /> @user.TotalDownvotes</div>
                </div>
                <div class="col-md-9 ">
                    <div class="row cursorPointer onHoverText"><p>@user.Username</p></div>
                    <div class="row cursorPointer onHoverText d-flex justify-content-between">
                        <div class="">
                            <ROHForum.Pages.UserProfile.UserKarmaBarSearchResults SearchUser="@user.Username" />
                        </div>

                    </div>
                </div>

                <div>
                </div>
            </div>
        }
    </div>


</div>

@code {
    [CascadingParameter]
    public UserInformation UserInformation { get; set; }

    public List<UserModel> users = new();

    public int CurrentPage { get; set; }

    public int PageSize { get; set; } = 5;
    public int TotalPages => (int)Math.Ceiling((double)users.Count() / PageSize);
    public bool ShowPrevious => CurrentPage > 1;
    public bool ShowNext => CurrentPage < TotalPages;
    public IEnumerable<UserModel> Items { get; set; }


    protected override void OnInitialized()
    {
        var updoot = UserInformation.userUpvotes;
        users = _userService.GetAllUsers();
        CurrentPage = 1;
        var skip = (CurrentPage - 1) * PageSize;
        Items = users.Skip(skip).Take(PageSize).ToList();
    }

    public void DoNext()
    {

        var skip = CurrentPage * PageSize;
        Items = users.Skip(skip).Take(PageSize).ToList();
        CurrentPage++;
    }

    public void DoPrevious()
    {
        CurrentPage--;
        var skip = (CurrentPage - 1) * PageSize;
        Items = users.Skip(skip).Take(PageSize).ToList();

    }


    public void DoSomethingElse(int i)
    {
        //var skip = (i - 1) * PageSize;
        Items = users.Skip(i - 1).Take(PageSize).ToList();
    }


    public void upvoteClicker(PostsModel postModel)
    {

      

    }



    public void downvoteClicker(PostsModel postModel)
    {

 
 


    }
}



