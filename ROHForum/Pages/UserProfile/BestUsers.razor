    background-color:black;
    }

    .pagination {
        background-color: black;
    }

    .page-link {
        background-color: none;
        color: black;
        border-color: transparent;
    }

    .page-item.active .page-link {
        box-shadow: 5px 5px black;
        background-color: transparent;
        color: black;
        border-color: black;
        border: 2px black solid;
    }

    .page-link:focus {
        background-color: none;
        font-weight: 700;
        color: black;
    }
</style>