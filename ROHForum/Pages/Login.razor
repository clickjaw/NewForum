@page "/"
@using ROHForum.Authentication
@using ViewModels
@inject AuthenticationStateProvider authStateProvider

@layout BlankPage



<div class="container crt" style="" >
    <EditForm Model = "user" Context="formContext" OnValidSubmit="LoginUser" OnInvalidSubmit="ReturnToLogin">
        <div>
            <div style="font-size:26px; display:@toggleFormLogin">
                <label class="px-4 mx-2 mb-4 loginLabel"><h2>Login</h2></label>
                <div class="m-4 w-50"><label class="px-4 mx-2 mb-4 @loginUsername">Username</label><InputText class="px-4 mx-2 customButton" style="font-size:26px;background-color:white;" @bind-Value="user.Username" /></div>
                <div class="m-4 w-50"><label class="px-4 mx-2 mb-4 @loginPassword">Password</label><InputText type="password" style=" font-size:26px;background-color:white;" class="px-4 mx-2 customButton" @bind-Value="user.Password" /></div>
                <div class="row">
                    <div class="col-md-3">

                        <button type="button" class="px-4 mx-2 customButton" @onclick="ToggleNewUser">New User?</button>
                    </div>
                    <div class="col-md-3"><button class="px-4 mx-2 customButtonLogin" type="submit">Login</button></div>

                </div>
            </div>




        </div>

    </EditForm>
    <EditForm Model="newUser" Context="formContext" OnValidSubmit="LoginNewUser" OnInvalidSubmit="ReturnToLogin">
        <div>
            <div style="font-size:26px; display:@toggleFormNewUser">
                <label class="px-4 mx-2 mb-4 loginLabel"><h2>New user registration</h2></label>
                <div class="m-4 w-50"><label class="px-4 mx-2 mb-4 loginLabel">Username</label><InputText @bind-Value="newUser.Username" /></div>
                <div class="m-4 w-50"><label class="px-4 mx-2 mb-4 loginLabel">Password</label><InputText type="password" @bind-Value="newUser.Password" /></div>
                <div><button type="submit" class="px-4 mx-2 customButtonLogin">Create Account</button></div>
            </div>




        </div>

    </EditForm>
</div>

<style>
    .valid.modified:not([type=checkbox]){
    outline:none;
    }
</style>

@code {

    public UserModel user = new();
    public UserModel newUser = new();
    public UserModel validateUser = new();
    public UserSessionViewModel userSessionViewModel = new();

    public string? toggleFormLogin;
    public string? toggleFormNewUser;

    public string? loginUsername;
    public string? loginPassword;

    public async Task LoginUser()
    {
        if (user is not null)
        {
            validateUser = _userService.ValidateUser(user);
        }
        else
        {
            loginUsername = "loginLabelError";
            //ReturnToLogin();
        }

        if (validateUser.Username is not null)
        {


            userSessionViewModel.Username = user.Username;
            userSessionViewModel.UserId = user.UserId;
            var customAuthStateProvider = (CustomAuthenticationStateProvider)authStateProvider;
            await customAuthStateProvider.UpdateAuthenticationState(userSessionViewModel);

            _navManager.NavigateTo("/home/"+ user.Username);
        }
        else
        {
            if (validateUser.Password == "InvalidUser")
                loginUsername = "loginLabelError";
            if(validateUser.Password == "InvalidPassword")
                loginPassword = "loginLabelError";

            //ReturnToLogin();
        }
    }

    public async Task LoginNewUser()
    {
        bool testUser = _userService.AddNewUser(newUser);
        
        if (testUser)
        {

            userSessionViewModel.Username = newUser.Username;
            userSessionViewModel.UserId = newUser.UserId;
            userSessionViewModel.TotalUpvotes = 1;
            var customAuthStateProvider = (CustomAuthenticationStateProvider)authStateProvider;
            await customAuthStateProvider.UpdateAuthenticationState(userSessionViewModel);

            _navManager.NavigateTo("/home/" + newUser.Username);
        }
        else
        {
            ReturnToLogin();
        }



    }



    public void ReturnToLogin()
    {
        _navManager.NavigateTo("/");
    }

    public void ToggleNewUser()
    {
        toggleFormNewUser = "block";
        toggleFormLogin = "none";
    }

    protected override void OnInitialized()
    {
        toggleFormLogin = "block";
        toggleFormNewUser = "none";
        loginUsername = "loginLabel";
        loginPassword = "loginLabel";



    }


}
